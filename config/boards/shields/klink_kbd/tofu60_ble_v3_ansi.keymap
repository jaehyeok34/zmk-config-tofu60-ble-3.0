#include "common.keymap"

#define UF_RESET bootloader_reset 0 0
#define UF_BT1 device_bt1 0 0
#define UF_BT2 device_bt2 0 1
#define UF_BT3 device_bt3 0 2

/ {
    keymap {
        compatible = "zmk,keymap";
        
        default_layer {
            bindings = <
    &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp LGUI &kp BSPC
    &kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT  &kp RBKT  &lt_hp 2 BSLH
    &mo 1    &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT        &kp RET
    &kp LSHFT &none &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH      &kp UP  &kp RIGHT
    &none &kp LCTRL &kp LALT             &kp SPACE                       &none  &kp LEFT  &kp DOWN &none
            >;
        };

        layer1 {
            bindings = <
    &kp GRAVE  &kp F1    &kp F2    &kp F3  &kp F4   &kp F5  &kp F6  &kp F7  &kp F8   &kp F9   &kp F10  &kp F11 &kp F12  &kp INS  &kp DELETE
    &kp CAPS &kp LA(LEFT)    &kp LA(RIGHT)    &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))   &ctrl_k_z  &none  &none  &none  &none  &none  &private  &netcus  &kp RSHIFT 
    &none   &ctrl_k_e  &kp LS(LA(DOT))  &kp F12  &ctrl_m_m  &ctrl_m_l  &none  &none  &none  &none  &none  &none   &kp RET 
    &kp LSHFT &none  &kp LS(LG(LEFT))    &kp LC(LS(F9))    &kp LS(F7)  &kp LG(TAB) &none  &none  &none  &none  &none   &none   &kp PAGE_UP  &kp END
    &none  &kp LCTRL   &kp LALT                            &kp RALT                                   &none    &kp HOME      &kp PAGE_DOWN   &none
            >;
        };

        layer2 {
            bindings = <
    &kp ESC  &kp F1    &kp F2    &kp F3  &kp F4   &kp F5  &kp F6  &kp F7  &kp F8   &kp F9   &kp F10  &kp F11 &kp F12  &kp INS  &kp DELETE
    &none &UF_BT1    &UF_BT2    &UF_BT3  &none   &none  &none  &none  &none  &none  &none  &kp LS(COMMA)  &kp LS(DOT)  &none 
    &none   &none  &none  &none  &none  &none  &none  &none  &none  &kp C_MUTE  &kp C_VOLUME_DOWN     &kp C_VOL_UP &none 
    &none &none  &none    &none    &none  &none &bootloader  &none  &none  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC   &none   &none &none
    &none  &none   &none                            &Device_USB                                   &none    &none     &none   &none
            >;
        };

        layer3 { status = "reserved"; };
        layer4 { status = "reserved"; };
        layer5 { status = "reserved"; };
        layer6 { status = "reserved"; };
        layer7 { status = "reserved"; };
    };
};
